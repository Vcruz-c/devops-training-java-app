/* 
  Practica 2 - Jenkinsfile dummy (PUNTO DE PARTIDA)

  Este Jenkinsfile es intencionalmente simple. En la Practica 2 iras anadiendo
  piezas (stages, agents, funciones Groovy, Docker build, docker compose, etc.)
  hasta construir un pipeline CI/CD completo.
*/
 
pipeline {
  // `agent any` = el pipeline se ejecuta en cualquier nodo/agente disponible.
  agent any

  stages {
    stage('Test') {
      /*
        `agent` dentro de un stage permite que SOLO ese stage se ejecute en un contexto concreto.
        En este caso, usamos Docker como capa de virtualizacion: los comandos se ejecutan dentro
        de un contenedor temporal.
      */
      agent {
        docker {
          image 'maven:3.8.6-openjdk-11-slim'
        }
      }
      steps {
        sh 'mvn -version'
        sh 'apt-get update'
        sh 'apt-get install -y make'
        sh 'make lint' // La imagen utilizada no tiene make.
        //Podemos añadir make a la imagen (imagen algo más pesada), ejecutar directamente o crear una imagen
        //mvn -q -DskipTests=true test. Añadimos make para aprovechar el Makefile ya hecho
        //Los make son parte de un archivo llamado Makefile que permite definir instrucciones
        //y acortar algo que puede ser más largo, por ejemplo lint = mvn -q -DskipTests=true test
        sh 'make test'
      }
    }
    /**
    * STage intermedio para empaquetar la aplicación
    */
    stage("package"){
      agent {
        docker {
          image 'maven:3.8.6-openjdk-11-slim'
        }
      }
      steps{
        sh 'mvn -q package -DskipTests'
      }
    }

    /**
    *stage de build donde se construye la imagen docker a partir del Dockerfile.
    */
    stage("Build"){
      steps{
        sh 'docker version'
        //Ahora vamos a construir imagen docker a partir de Dockerfile 
        sh 'docker build -t scalian_training-java-hello-world:0.0.2 --build-arg VERSION=0.0.1-SNAPSHOT -f devops/Dockerfile .'
      }
    }

    /**
    *stage de despliegue, donde se lanza el contenedor a partir de la imagen construida en el stage anterior.
    * Vamos a usar el mismo agent de jenkins (no podemos nada de agent aqui y usará el agent del pipeline)
    */
    stage("Deploy"){
      steps{
        //Ahora vamos a lanzar el contenedor a partir de la imagen construida en el stage anterior.
        sh 'docker compose -f docker-compose.yml up -d'
      }
    }
    /**
    *stage de prueba end to end, donde se hace una petición HTTP al endpoint /hello para comprobar que la aplicación se ha desplegado correctamente.
    */
    stage("Prueba end to end"){
      steps{
        sh '''#!/bin/bash
        for i in {1..10}; do
          echo "Intento $i de conexión al endpoint..."
          if curl -f -u user:test http://172.17.0.1:8084/hello; then
            echo "Endpoint funcionando correctamente"
            exit 0
          fi
          echo "Esperando a que arranque la app..."
          sleep 5
        done
        echo "ERROR: la aplicación no responde después de varios intentos"
        exit 1
        '''
      }
    }
    /**
    *stage de limpieza, donde se detiene y elimina el contenedor y la imagen docker para dejar el entorno limpio
    */
    stage("Cleanup"){
      steps{
        sh 'docker compose -f docker-compose.yml down --volumes'
      }
    }
  }
}
